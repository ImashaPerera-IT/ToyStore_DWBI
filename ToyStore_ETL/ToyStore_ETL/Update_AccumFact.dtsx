      DTS:refId="Package\Update FactSales"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{6D06A5DA-78E3-4E1E-802D-E0A20A123FA7}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Update FactSales"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{34C6A925-D3F1-4DD3-882C-D4AAE37CE4E5}"
          SQLTask:SqlStatementSource="UPDATE fs&#xA;SET fs.accm_txn_complete_time = sc.accm_txn_complete_time&#xA;FROM FactSales fs&#xA;INNER JOIN Stage_OrderCompletions sc&#xA;  ON fs.OrderItemID = sc.order_item_id;&#xA;&#xA;-- Log unmatched rows&#xA;INSERT INTO Stage_UnmatchedCompletions&#xA;  (order_item_id, accm_txn_complete_time)&#xA;SELECT sc.order_item_id, sc.accm_txn_complete_time&#xA;FROM Stage_OrderCompletions sc&#xA;LEFT JOIN FactSales fs&#xA;  ON fs.OrderItemID = sc.order_item_id&#xA;WHERE fs.OrderItemID IS NULL;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
